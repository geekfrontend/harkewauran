---
import "@/styles/global.css";
import { site } from "@/config/site";
import { languages, type Lang } from "@/i18n/ui";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t("site.title"), description = t("site.description") } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localizePath(Astro.url, l), Astro.site)}
        />
      ))
    }

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- Social preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme: "light" | "dark" | "system", dark by default. Runs before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const KEY = "theme";
        const OPTIONS = ["light", "dark", "system"];
        const media = matchMedia("(prefers-color-scheme: dark)");
        let choice = "dark";
        try {
          const stored = localStorage.getItem(KEY);
          if (OPTIONS.includes(stored)) choice = stored;
        } catch {}
        const root = document.documentElement;
        const isDark = () => choice === "dark" || (choice === "system" && media.matches);
        const apply = () => root.classList.toggle("dark", isDark());

        // Reveal the new theme as a circle growing from `origin` (the clicked button).
        const reveal = (origin) => {
          const wasDark = root.classList.contains("dark");
          if (!origin || !document.startViewTransition || wasDark === isDark()) return apply();
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const transition = document.startViewTransition(apply);
          if (reduce) return;
          const { left, top, width, height } = origin.getBoundingClientRect();
          const x = left + width / 2;
          const y = top + height / 2;
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          transition.ready.then(() =>
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              {
                duration: 500,
                easing: "cubic-bezier(0.23, 1, 0.32, 1)", // --ease-out
                pseudoElement: "::view-transition-new(root)",
              },
            ),
          );
        };

        window.__theme = {
          get: () => choice,
          set: (value, origin) => {
            if (!OPTIONS.includes(value)) return;
            choice = value;
            try {
              localStorage.setItem(KEY, value);
            } catch {}
            reveal(origin);
          },
        };
        media.addEventListener("change", apply);
        apply();
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
